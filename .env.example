DATABASE_URL=postgresql://user:password@host:5432/roteia?sslmode=require

# Optional: OpenRouteService API key for routing/geocoding (leave empty to use Nominatim fallback)
ORS_API_KEY=

# Session cookie secret. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Base URL of the deployment (used by Server Actions / redirects in production)
NEXT_PUBLIC_APP_URL=https://roteia.vercel.app